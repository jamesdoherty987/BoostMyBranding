# Local dev: run `pnpm dev` or `pnpm dev:stack` from the REPO ROOT so Next.js (:3000) and the API (:4000) both start.
# `cd apps/api && pnpm dev` starts only the API — localhost:3000 will not respond.

NODE_ENV=development
API_PORT=4000
# When R2 is off, upload URLs use this host for /uploads/... (defaults to APP_URL in production).
# API_PUBLIC_URL=https://api.yourdomain.com

APP_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000/portal
DASHBOARD_URL=http://localhost:3000/dashboard

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000/portal
API_UPSTREAM=

AUTH_SECRET=
DATABASE_URL=

ANTHROPIC_API_KEY=
# fal.ai bills per API request (each shot in director mode is separate). Premium video
# (Kling Master, Higgsfield, WAN, etc.) adds up fast — tens of dollars per long video
# is normal if you have many shots. To avoid fal entirely: leave FAL_KEY unset and use
# GEMINI_API_KEY (Nano Banana + Veo 3) and/or OPENAI_API_KEY (DALL·E / Sora) for personal
# generation; other features fall back to mocks or skip fal-only edits when the key is absent.
# With GEMINI_API_KEY set, default **still** images use Nano Banana (Gemini); Fal-only image models still need Fal credits.
FAL_KEY=
# Optional: max concurrent fal.ai jobs in this API process (1–10). Default 8. fal often caps ~10; personal director + cron + inspiration share one key.
# FAL_MAX_CONCURRENT=8

# Cloudflare R2
# If any are missing, the API falls back to local disk under tmp/uploads (not suitable for long video jobs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public https base for the bucket (no trailing slash required). Required when R2 is on — voice/music URLs must be fetchable by the API.
R2_PUBLIC_URL=
# Optional: https base used only for built-in stock music (`{base}/public/music/*.mp3`). Use when R2 is off, or when R2_PUBLIC_URL is not DNS-reachable from this machine (local dev).
# PERSONAL_MUSIC_CDN_URL=https://pub-xxxxx.r2.dev
# Optional: R2 prefix for operator-uploaded background tracks (.mp3, .m4a, …). If unset, each personal account uses `public/personal-music/{accountId}/`.
# PERSONAL_MUSIC_LIBRARY_PREFIX=public/team-music
# Force local disk even when R2 vars are set: true | false | 1 | 0 | yes | no (case-insensitive). Omit to use R2 when fully configured.
# R2_DISABLED=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOCIAL=
STRIPE_PRICE_WEBSITE=
STRIPE_PRICE_FULL=

VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

CONTENTSTUDIO_API_KEY=
CONTENTSTUDIO_WORKSPACE_ID=
# Optional: HTTPS URL of the Content Studio product (shown in Personal → Posting so users can connect YouTube / Instagram there).
# CONTENTSTUDIO_APP_URL=https://app.contentstudio.com
# Set to 1 on the API process to log personal headline generation (topic, examples count, each candidate).
# PERSONAL_DEBUG_TITLES=1
# Set to 1 on the API for verbose console lines during director **media sourcing** (per-shot start/end, models,
# checkpoint DB write start/end). The dashboard "Generation log" also records checkpoint duration (ms) per flush.
# PERSONAL_DEBUG_SOURCING=1
# Title-only JSON step uses a separate Claude model (default: haiku). Set to sonnet/opus to match the main script model.
# PERSONAL_TITLE_MODEL=haiku
# 0–1 sampling for title JSON (default ~0.78). Lower = same headline repeated for the same topic.
# PERSONAL_TITLE_TEMPERATURE=0.85
# Isolated title test only: model that invents a topic when you pass no CLI args (default: sonnet).
# PERSONAL_TOPIC_INVENT_MODEL=sonnet
# Hard caps (ms) for one director shot so sourcing_media cannot hang forever on a stuck fal/Gemini call.
# Defaults when unset: image 240000 (4m), video 600000 (10m). Max image 900000, video 1800000.
# PERSONAL_AI_IMAGE_TIMEOUT_MS=240000
# PERSONAL_AI_VIDEO_TIMEOUT_MS=600000
# R2 upload (per image buffer) after Gemini/fal — default 120000 (2m). Range 10000–900000.
# PERSONAL_R2_UPLOAD_TIMEOUT_MS=120000
# Isolated title test (`pnpm test:isolated-channel-title`): with DATABASE_URL and exactly one personal
# channel, that account is used automatically (saved example titles + recent titles like production).
# Set PERSONAL_TITLE_TEST_USER_ID + PERSONAL_TITLE_TEST_ACCOUNT_ID only if you have multiple channels.
# Otherwise: built-in fixture examples, or pass two UUIDs on the CLI. Optional: PERSONAL_TITLE_TEST_LONGFORM=1
# Force fixture: pnpm test:isolated-channel-title -- --fixture "topic"
# Print ids for .env: pnpm print:personal-title-test-env
# PERSONAL_TITLE_TEST_USER_ID=
# PERSONAL_TITLE_TEST_ACCOUNT_ID=

RESEND_API_KEY=
FROM_EMAIL=

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:4000/api/v1/canva/callback

CRON_SECRET=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

ELEVENLABS_API_KEY=
OPENAI_API_KEY=

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_VEO_MODEL=

RUNWAY_API_KEY=
REPLICATE_API_TOKEN=

# Used for stitch, probes, and extracting a still from video inspiration uploads (reference frames for AI shots).
FFMPEG_PATH=

# Optional absolute path to a .ttf/.otf used for keyword pop-ups / sparse captions in personal FFmpeg stitch,
# and for the small title line on AI-generated post thumbnails (otherwise common system fonts are used; macOS
# and Linux have built-in fallbacks).
# Windows example: PERSONAL_OVERLAY_FONT=C:/Windows/Fonts/segoeui.ttf
# macOS example: PERSONAL_OVERLAY_FONT=/System/Library/Fonts/Supplemental/Arial.ttf
# PERSONAL_OVERLAY_FONT=

# Personal stitch (FFmpeg libx264): faster presets = shorter CPU time, softer compression.
# Account `stitchEncodePreset` (dashboard) is used only when PERSONAL_STITCH_PRESET is unset.
# Long multi-shot videos are encoded **sequentially** (each shot = full H.264 pass); 20–60+ minutes
# for long 1080p timelines is normal on a typical CPU. Try ultrafast for drafts:
# PERSONAL_STITCH_PRESET=ultrafast
# PERSONAL_STITCH_PRESET=veryfast
# CRF 18–35 (lower = sharper / larger files). If unset: NODE_ENV=production defaults to 22, else 23.
# PERSONAL_STITCH_CRF=23
# Optional `-profile:v high` for libx264 (better device compatibility at same CRF). Set 0 to skip.
# PERSONAL_STITCH_H264_PROFILE=0

# Extra FFmpeg timing lines ([stitcher:timing] …). Default: on in dev, off in prod unless set to 1.
# PERSONAL_STITCH_TIMING=1
# PERSONAL_STITCH_TIMING=0
# Log throttled libx264 progress lines (`frame=` …) to the server console during long encodes.
# Default: on when NODE_ENV is not production; set 0 to silence, 1 to force on in prod.
# PERSONAL_STITCH_FFMPEG_STATS=1
# PERSONAL_STITCH_FFMPEG_STATS=0
# Very verbose FFmpeg stitch logs: full argv, cwd, complete `-vf` / filter_complex per shot, stderr lines matching filter/error, full stderr on failure, workdir file list. **High volume** — use only while debugging Windows/normalize failures.
# Failed normalize also logs `[stitcher:normalize-failed]` + raw stderr tail; dev logs `[stitcher:normalize-start]` per shot.
# PERSONAL_DEBUG_STITCH_FFMPEG=1
# Same pre-invoke JSON as above for **every** normalize shot, without forcing FFmpeg `-loglevel verbose` (pairs well with failures).
# PERSONAL_DEBUG_STITCH_NORMALIZE=1

# Verbose pacing debug: voice partition → stitch scale → per-segment FFmpeg args + probed MP4 duration.
# Values: 1 | true | yes | on (case-insensitive). Off when unset.
# PERSONAL_DEBUG_VISUAL_PACING=1
# Verbose mux debug: concat probe vs plan, mix-audio apad, VO/music probes, final output probe.
# PERSONAL_DEBUG_MIX_AUDIO=1
# Shorthand: enables the same logs as VISUAL_PACING + MIX_AUDIO together.
# PERSONAL_DEBUG_STITCH_TIMELINE=1

# Fail personal posts stuck in-flight from a *prior* process (`rendering`, or
# `queued` / `scripting` / `sourcing_media` when updatedAt is before this API boot).
# Default: on when NODE_ENV is not production; off in production unless set true.
# PERSONAL_RESET_RENDERING_ON_BOOT=true
# When PERSONAL_RESUME_DIRECTOR_ON_BOOT is off, director posts still in sourcing_media after a
# restart are marked failed on boot (e.g. dev Ctrl+C)—use resume=true on one host if you want them to continue.

# Resume director-mode personal videos after API restart (checkpointed jobs only).
# Default **off** everywhere (no surprise fal spend after deploy). Set true on a
# single-node host when you want crash/deploy recovery without pressing Generate.
# PERSONAL_RESUME_DIRECTOR_ON_BOOT=true

# Mark personal posts stuck in rendering / scripting / etc. as failed after this
# many milliseconds without progress (cron every 5 minutes). Default: 3h in
# production, 45m when NODE_ENV is not production. Minimum when set: 60000.
# PERSONAL_STALE_PIPELINE_MS=2700000
